{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Arduino: 编译 ESP32-S3",
      "type": "shell",
      "command": "C:\\Program Files\\Arduino CLI\\arduino-cli.exe",
      "args": [
        "compile",
        "--fqbn",
        "esp32:esp32:esp32s3:PSRAM=opi",
        "--build-path",
        "${workspaceFolder}\\.build",
        "${workspaceFolder}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Arduino: 烧录 ESP32-S3",
      "type": "shell",
      "command": "C:\\Program Files\\Arduino CLI\\arduino-cli.exe",
      "args": [
        "upload",
        "--fqbn",
        "esp32:esp32:esp32s3:PSRAM=opi",
        "--port",
        "COM7",
        "--input-dir",
        "${workspaceFolder}\\.build",
        "${workspaceFolder}"
      ],
      "dependsOn": "Arduino: 编译 ESP32-S3",
      "problemMatcher": []
    },
    {
      "label": "Arduino: 打开串口监视器",
      "type": "shell",
      "command": "C:\\Program Files\\Arduino CLI\\arduino-cli.exe",
      "args": [
        "monitor",
        "--port",
        "COM7",
        "--config",
        "baudrate=115200"
      ],
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Arduino: 查看开发板和串口",
      "type": "shell",
      "command": "C:\\Program Files\\Arduino CLI\\arduino-cli.exe",
      "args": ["board", "list"],
      "problemMatcher": []
    }
  ]
}
